// Icon file
IDI_ICON1 ICON DISCARDABLE "jadeite_lite.ico"

// Remember to update this info for all new releases
1 VERSIONINFO
	FILEVERSION 1, 0, 0, 0
	PRODUCTVERSION 1, 0, 0, 0
{
	BLOCK "StringFileInfo"
	{
		BLOCK "000004B0"
		{
			VALUE "CompanyName", "Jade-ite Games Studios\0"
			VALUE "FileDescription", "Jadeite Lite Starter App\0"
			VALUE "FileVersion", "1.0.0.0\0"
			VALUE "OriginalFilename", "JadeiteLite.exe\0"
			VALUE "ProductName", "JadeiteLite\0"
			VALUE "ProductVersion", "1.0.0.0\0"
			VALUE "LegalCopyright", "Copyright (C) 2026 Jade-ite Games @ Dustin Clark.\0"
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0000, 0x04B0
	}
}
